# Copie este arquivo para .env.local e preencha com os valores do seu ambiente local.
# Não commite segredos reais.

# Conexão PostgreSQL do Supabase (URL completa, incluindo senha).
SUPABASE_DB_URL=

# Variáveis públicas usadas pela SDK do Supabase no navegador/SSR.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
