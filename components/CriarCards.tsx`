"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { criarCardAction, criarCardsAction } from "@/app/actions";
import { dataValida, adicionarDias } from "@/lib/dates";
import { CampoData } from "./CampoData";
import { useSync } from "./SyncProvider";

const MAX_DIAS = 366;

type Modo = "unico" | "varios" | "semana";

const DIAS_SEMANA = [
  { id: 1, nome: "Segunda" },
  { id: 2, nome: "Terça" },
  { id: 3, nome: "Quarta" },
  { id: 4, nome: "Quinta" },
  { id: 5, nome: "Sexta" },
  { id: 6, nome: "Sábado" },
  { id: 0, nome: "Domingo" },
];

export function CriarCards({ hoje }: { hoje: string }) {
  const router = useRouter();
  const { notificar } = useSync();

  const [modo, setModo] = useState<Modo | null>(null);
  const [data, setData] = useState(hoje);
  const [inicio, setInicio] = useState(hoje);
  const [quantidade, setQuantidade] = useState("7");
  const [diasSelecionados, setDiasSelecionados] = useState<number[]>([]);
  const [salvando, setSalvando] = useState(false);
  const [erro, setErro] = useState<string | null>(null);

  useEffect(() => {
    if (modo === null) return;

    function aoTeclar(evento: KeyboardEvent) {
      if (evento.key === "Escape") setModo(null);
    }

    document.addEventListener("keydown", aoTekar);
    const overflowAnterior = document.body.style.overflow;
    document.body.style.overflow = "hidden";

    return () => {
      document.removeEventListener("keydown", aoTekar);
      document.body.style.overflow = overflowAnterior;
    };
  }, [modo]);

  function abrir(novoModo: Modo) {
    setErro(null);
    setData(hoje);
    setInicio(hoje);
    setQuantidade("7");
    setDiasSelecionados([]);
    setModo(novoModo);
  }

  function fechar() {
    if (salvando) return;
    setModo(null);
    setErro(null);
  }

  function alternarDia(diaId: number) {
    setDiasSelecionados(prev =>
      prev.includes(diaId) ? prev.filter(d => d !== diaId) : [...prev, diaId]
    );
  }

  async function salvar(evento: React.FormEvent) {
    evento.preventDefault();
    if (modo === null || salvando) return;

    setErro(null);

    if (modo === "unico") {
      if (!dataValida(data)) {
        setErro("Escolha uma data válida.");
        return;
      }
      setSalvando(true);
      const resultado = await criarCardAction(data);
      setSalvando(false);
      if (!resultado.ok) {
        setErro(resultado.erro);
        return;
      }
    } else if (modo === "varios") {
      if (!dataValida(inicio)) {
        setErro("Escolha uma data inicial válida.");
        return;
      }
      const dias = Number(quantidade);
      if (!Number.isInteger(dias) || dias < 1 || dias > MAX_DIAS) {
        setErro(`Escolha de 1 a ${MAX_DIAS} dias.`);
        return;
      }
      setSalvando(true);
      const resultado = await criarCardsAction(inicio, dias);
      setSalvando(false);
      if (!resultado.ok) {
        setErro(resultado.erro);
        return;
      }
    } else if (modo === "semana") {
      if (diasSelecionados.length === 0) {
        setErro("Selecione pelo menos um dia da semana.");
        return;
      }
      setSalvando(true);

      try {
        // Para cada dia da semana selecionado, criamos um card para a semana atual
        // Nota: A action criarCardsAction cria X dias a partir de uma data.
        // Para criar dias específicos da semana, vamos iterar e criar cards individuais
        // ou adaptar a lógica. Para simplicidade e seguindo a API atual:
        for (const diaId of diasSelecionados) {
          // Encontrar a data do dia da semana na semana atual
          const d = new Date();
          const currentDay = d.getUTCDay(); // 0=Dom, 1=Seg...
          const diff = diaId - currentDay;
          const dataAlvo = adicionarDias(hoje, diff);
          await criarCardAction(dataAlvo);
        }
      } catch (e) {
        setErro("Erro ao gerar cards da semana.");
      } finally {
        setSalvando(false);
      }
    }

    setModo(null);
    notificar();
    router.refresh();
  }

  return (
    <>
      <button
        type="button"
        onClick={() => abrir("unico")}
        className="rounded-[10px] bg-accent px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Novo card
      </button>
      <button
        type="button"
        onClick={() => abrir("varios")}
        className="rounded-[10px] border border-border bg-surface px-3.5 py-2 text-sm font-medium text-text transition-colors hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Gerar dias
      </button>
      <button
        type="button"
        onClick={() => abrir("semana")}
        className="rounded-[10px] border border-border bg-surface px-3.5 py-2 text-sm font-medium text-text transition-colors hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Criar por dia da semana
      </button>

      {modo !== null && (
        <div
          className="fixed inset-0 z-50 flex items-stretch justify-center bg-black/60 backdrop-blur-sm sm:items-center sm:p-4"
          onMouseDown={(evento) => {
            if (evento.target === evento.currentTarget) fechar();
          }}
        >
          <div
            role="dialog"
            aria-modal="true"
            aria-labelledby="titulo-criar-card"
            className="flex h-full w-full flex-col bg-surface shadow-2xl sm:h-auto sm:max-h-[90vh] sm:max-w-md sm:rounded-2xl"
          >
            <div className="flex items-center justify-between border-b border-border px-5 py-4">
              <h2
                id="titulo-criar-card"
                className="text-lg font-semibold tracking-tight text-text"
              >
                {modo === "unico" ? "Novo card" : modo === "varios" ? "Gerar dias" : "Criar por dia da semana"}
              </h2>
              <button
                type="button"
                onClick={fechar}
                disabled={salvando}
                aria-label="Fechar"
                className="rounded-md p-1.5 text-xl leading-none text-text-muted transition-colors hover:bg-surface-2 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-40"
              >
                <span aria-hidden="true">×</span>
              </button>
            </div>

            <form onSubmit={salvar} className="space-y-4 px-5 py-5">
              <p className="text-sm text-text-muted">
                {modo === "unico"
                  ? "Crie um card para qualquer dia, mês ou ano."
                  : modo === "varios"
                    ? "Crie vários cards seguidos a partir de uma data."
                    : "Selecione os dias da semana para criar cards automaticamente."}
              </p>

              {erro && (
                <p
                  role="alert"
                  className="rounded-lg border border-danger bg-danger-bg px-3 py-2 text-sm text-danger"
                >
                  {erro}
                </p>
              )}

              {modo === "unico" ? (
                <CampoData
                  rotulo="Data do card"
                  valor={data}
                  aoMudar={setData}
                  autoFocus
                />
              ) : modo === "varios" ? (
                <>
                  <CampoData
                    rotulo="Data inicial"
                    valor={inicio}
                    aoMudar={setInicio}
                    autoFocus
                  />
                  <label className="block text-sm font-medium text-text">
                    Quantidade de dias
                    <input
                      type="number"
                      min={1}
                      max={MAX_DIAS}
                      value={quantidade}
                      onChange={(evento) => setQuantidade(evento.target.value)}
                      className="mt-1 block w-full rounded-[10px] border border-border bg-surface-2 px-3 py-2 text-sm text-text placeholder:text-text-muted focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                    />
                    <span className="mt-1 block text-xs font-normal text-text-muted">
                      Até {MAX_DIAS} dias por vez. Cada dia recebe os hábitos ativos.
                    </span>
                  </label>
                </>
              ) : (
                <div className="grid grid-cols-2 gap-2">
                  {DIAS_SEMANA.map((dia) => (
                    <button
                      key={dia.id}
                      type="button"
                      onClick={() => alternarDia(dia.id)}
                      className={[
                        "flex items-center justify-center rounded-lg px-3 py-2 text-sm transition-all border",
                        diasSelecionados.includes(dia.id)
                          ? "bg-accent border-accent text-white"
                          : "bg-surface border-border text-text-muted hover:bg-surface-2",
                      ].join(" ")}
                    >
                      {dia.nome}
                    </button>
                  ))}
                </div>
              )}

              <div className="flex items-center gap-2 pt-1">
                <button
                  type="submit"
                  disabled={salvando}
                  className="rounded-[10px] bg-accent px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-40"
                >
                  {salvando
                    ? "Criando..."
                    : modo === "unico"
                      ? "Criar card"
                      : modo === "varios"
                        ? "Gerar cards"
                        : "Criar selecionados"}
                </button>
                <button
                  type="button"
                  onClick={fechar}
                  disabled={salvando}
                  className="rounded-[10px] px-3 py-2 text-sm text-text-muted transition-colors hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-40"
                >
                  Cancelar
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </>
  );
}
